{
  "$schema": "https://shmaptech.com/schemas/room/v0.2.json",
  "id": "oudkempeneet-cafe-pitch",
  "parent": "merritt-studio",
  "root": "~/shmorganism/workshop/oudkempeneet-cafe-pitch",
  "fate": "keep",
  "prime": {
    "head": "oudkempeneet-cafe",
    "model": "claude-opus-5",
    "mode": "bypass",
    "residency": "resident"
  },
  "comms": {
    "channels": [
      {
        "kind": "hq-chat",
        "id": "oudkempeneet-cafe-pitch"
      }
    ],
    "may_message_prime": [
      "schyler",
      "charlotte",
      "fable",
      "protocol"
    ],
    "escalate_to": "charlotte"
  },
  "permissions": {
    "write_roots": [
      "~/shmorganism/workshop/oudkempeneet-cafe-pitch",
      "~/shmorganism/soma/worktrees/oudkempeneet-cafe-pitch"
    ],
    "deny": [
      "~/shmorganism/animus",
      "~/.claude",
      "~/shmorganism/core/fleet/CONSTITUTION.md",
      "~/.config/hq/vault"
    ],
    "external": {
      "email": "ask",
      "telegram": "send",
      "deploy": "own-hosts",
      "payments": "never"
    },
    "secrets": []
  },
  "protocol": {
    "reviewer": "fresh-headless",
    "refute": true,
    "gates": [
      "bugs",
      "hallucination",
      "code-quality",
      "security"
    ],
    "ledger": ".hq/findings.jsonl",
    "repos": [
      "Charlotte-s-suite/oudkempeneet-cafe-pitch"
    ],
    "wall": "required-status",
    "clarify_before_build": true
  },
  "tasks": {
    "proof": "required",
    "watcher": "hq-proof-watch",
    "cwd": ".",
    "timeout_s": 120
  },
  "subagents": {
    "record": "transcripts+findings"
  },
  "surfaces": [
    {
      "kind": "agents"
    },
    {
      "kind": "tasks",
      "filter": "room=oudkempeneet-cafe-pitch"
    }
  ],
  "layout": {
    "phone": [
      [
        "agents"
      ],
      [
        "tasks"
      ]
    ],
    "tablet": [
      [
        "agents",
        "tasks"
      ]
    ],
    "desktop": [
      [
        "agents",
        "tasks"
      ]
    ]
  },
  "services": [],
  "links": [],
  "officers": {},
  "substrate": null
}
